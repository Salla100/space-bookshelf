# Space Vault — Environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit your actual keys.

# ── Notion ────────────────────────────────────────────────────────────────────
#
# 1. Go to https://www.notion.so/my-integrations
# 2. Click "New integration" → give it a name ("Space Vault Sync")
# 3. Set capabilities: Read content only
# 4. Copy the "Internal Integration Secret" below
#
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#
# 5. Open your Space Vault database in Notion
# 6. Click "..." menu → "Add connections" → select "Space Vault Sync"
# 7. Copy the database ID from the URL:
#    https://notion.so/YOUR-NAME/[DATABASE_ID_IS_HERE]?v=...
#    It's the 32-char string before the "?v="
#
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
